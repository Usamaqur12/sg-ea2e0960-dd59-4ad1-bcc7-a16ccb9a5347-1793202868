# Public browser configuration. Never put service-role or payment secrets here.

# =============================================================================
# اردو میں ہدایات: PRODUCTION_SETUP_GUIDE_URDU.md دیکھیں
# English Instructions: See PRODUCTION_SETUP_GUIDE_URDU.md for Urdu guide
# =============================================================================

PRODUCTION_MODE=false
# When true, server.js refuses to start unless production-critical configuration
# is present and both demo switches are disabled.
ENFORCE_PRODUCTION_READINESS=false

# Supabase Configuration (Get from: supabase.com/dashboard > Settings > API)
# Step 1.2 in PRODUCTION_SETUP_GUIDE_URDU.md
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Current Supabase projects use a publishable key. The legacy anon key remains
# supported for older projects; configure one public-key variable, not both.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo Mode - Production میں false rakhیں
# Keep demo mode enabled until licensing, KYC, payments and the production
# sportsbook feed have all passed their respective acceptance checks.
NEXT_PUBLIC_DEMO_MODE=true
# Local preview only. Never enable this on a public or production deployment.
NEXT_PUBLIC_ENABLE_DEMO_BACKEND=false

# Site Configuration (اپنی site کی details)
NEXT_PUBLIC_SITE_NAME=PrimeBet
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DISPLAY_CURRENCY=USD
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Server-only secrets. Never prefix these values with NEXT_PUBLIC_.
# یہ keys کبھی browser میں expose نہ کریں!
# Current projects may expose a secret key instead of the legacy service-role
# key. Configure one server-only variable, never a NEXT_PUBLIC_ secret.
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_SERVICE_ROLE_KEY=

# Security Secrets (Random strings generate کریں - minimum 32 characters)
# Online tool: https://www.random.org/strings/
SPORTS_FEED_WEBHOOK_SECRET=replace-with-a-long-random-provider-secret
# 32+ random characters used to encrypt sports provider API keys stored by the
# admin panel. Keep this stable after providers have been configured.
SPORTS_PROVIDER_ENCRYPTION_KEY=replace-with-a-different-long-random-encryption-key
CRON_SECRET=replace-with-a-different-long-random-cron-secret

# Crypto deposits: keep disabled until provider merchant approval, KYC/AML and
# gambling licensing are complete. These values are server-only.
# Crypto payments (NowPayments.io) - Optional
CRYPTO_DEPOSITS_ENABLED=false
NEXT_PUBLIC_CRYPTO_DEPOSITS_ENABLED=false
NOWPAYMENTS_API_KEY=replace-with-provider-api-key
NOWPAYMENTS_IPN_SECRET=replace-with-provider-ipn-secret

# Web push. The public VAPID key is safe for browsers; the private key must
# remain server-only. Keep WEB_PUSH_ENABLED=false until both keys are valid.
WEB_PUSH_ENABLED=false
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@example.com
API_RATE_LIMIT_SALT=replace-with-a-long-random-rate-limit-salt
# Optional locally; required for shared counters across production instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Browser errors are journaled internally. Configure this for off-site alerts.
ERROR_MONITORING_WEBHOOK_URL=
ERROR_MONITORING_WEBHOOK_TOKEN=

# Casino aggregator foundation. Keep disabled until a licensed provider signs
# the contract and callback/session endpoints pass certification.
CASINO_ENABLED=false
CASINO_AGGREGATOR_BASE_URL=
CASINO_AGGREGATOR_API_KEY=
CASINO_CALLBACK_SECRET=
CASINO_SESSION_PATH=/v1/sessions

# External identity/AML provider. Exact endpoint contracts are implemented
# after the licensed provider and API specification are selected.
KYC_PROVIDER_BASE_URL=
KYC_PROVIDER_API_KEY=
KYC_WEBHOOK_SECRET=

# Transactional communication providers.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
SMS_PROVIDER_API_KEY=
SMS_FROM=

# Public operating-licence identity displayed and audited at go-live.
GAMBLING_LICENSE_NUMBER=
GAMBLING_LICENSE_JURISDICTION=
